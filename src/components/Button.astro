---
// Botón plano (sin canto ni sombra). Comportamiento en src/scripts/buttons.ts
interface Props {
  href?: string;
  variant?: 'azul' | 'rojo' | 'crema' | 'marino';
  class?: string;
  type?: 'button' | 'submit';
  [key: string]: unknown;
}
const { href, variant = 'azul', class: cls, type = 'button', ...rest } = Astro.props;
const classes = ['btn', variant !== 'azul' && `btn--${variant}`, cls];
---

{
  href ? (
    <a href={href} class:list={classes} data-btn {...rest}>
      <span class="btn__face"><slot /></span>
    </a>
  ) : (
    <button type={type} class:list={classes} data-btn {...rest}>
      <span class="btn__face"><slot /></span>
    </button>
  )
}
