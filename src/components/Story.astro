---
// Historia: cuatro capítulos, cada uno en su propia banda a todo el ancho y con su color
// (marino, azul del escudo, amarillo del pabellón, rojo). En ≥768 px se alternan:
// texto a la izquierda / a la derecha. Entre el azul y el rojo, la línea negra del escudo.
// Movimiento: solo revelados verticales al entrar (src/scripts/story.ts).
import { content } from '../content';
import { siteConfig } from '../site.config';
import Picture from './Picture.astro';
import Court from './Court.astro';

const [c1, c2, c3, c4] = content.story.chapters;
---

<section class="story" id="historia" aria-labelledby="story-title" data-story>
  <article class="chapter chapter--1 mesh" aria-labelledby="ch-1" data-chapter>
    <div class="chapter__inner">
      <h2 class="story__title" id="story-title" data-story-title>{content.story.title}</h2>
      <div class="chapter__text">
        <header class="chapter__head">
          <p class="chapter__num">{c1.number}</p>
          <h3 class="chapter__title" id="ch-1">{c1.title}</h3>
        </header>
        <p class="chapter__lead" data-reveal>{c1.text}</p>
        <p class="chapter__punch" data-reveal>{c1.punch}</p>
      </div>
    </div>
  </article>

  <article class="chapter chapter--2 chapter--right" aria-labelledby="ch-2" data-chapter>
    <div class="chapter__inner">
      <div class="chapter__text">
        <header class="chapter__head">
          <p class="chapter__num">{c2.number}</p>
          <h3 class="chapter__title" id="ch-2">{c2.title}</h3>
        </header>
        <p class="chapter__lead" data-reveal>{c2.text}</p>
      </div>
      {
        siteConfig.showFoundersPhoto && (
          <div class="chapter__media">
            <figure class="print" data-print>
              <Picture name="mazo" alt={c2.photoAlt} sizes="(min-width: 1024px) 30vw, (min-width: 768px) 40vw, 80vw" imgClass="print__img" />
              <figcaption class="print__caption">{c2.caption}</figcaption>
            </figure>
          </div>
        )
      }
    </div>
  </article>

  <article class="chapter chapter--3 mesh" aria-labelledby="ch-3" data-chapter>
    <div class="chapter__inner">
      <div class="chapter__text">
        <header class="chapter__head">
          <p class="chapter__num">{c3.number}</p>
          <h3 class="chapter__title" id="ch-3">{c3.title}</h3>
        </header>
        <p class="chapter__lead chapter__lead--big" data-reveal>{c3.text}</p>
        <a class="chapter__link" href={c3.link.href} data-reveal>
          {c3.link.label}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v13m-6-5 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
    </div>
  </article>

  <article class="chapter chapter--4 chapter--right" aria-labelledby="ch-4" data-chapter>
    <div class="chapter__inner">
      <div class="chapter__text">
        <header class="chapter__head">
          <p class="chapter__num">{c4.number}</p>
          <h3 class="chapter__title" id="ch-4">{c4.title}</h3>
        </header>
        <p class="chapter__lead" data-reveal>{c4.text}</p>
      </div>
      <div class="chapter__media">
        <div class="kickoff" aria-hidden="true" data-kickoff>
          <Court class="kickoff__court" />
          <span class="kickoff__ball"></span>
        </div>
      </div>
    </div>
  </article>
</section>

<style>
  /* ---------- Bandas ---------- */
  .chapter {
    --bg: var(--marino);
    --ink: var(--claro);
    --accent: var(--oro);
    position: relative;
    background: var(--bg);
    color: var(--ink);
    padding: clamp(4rem, 11vh, 7.5rem) 0;
  }
  .chapter--1 { padding-top: clamp(4.5rem, 12vh, 8rem); }
  .chapter--2 { --bg: var(--azul-escudo); --accent: var(--crema); }
  /* Amarillo de la pared del pabellón (img2): rompe la secuencia de azules */
  .chapter--3 { --bg: var(--oro); --ink: var(--marino); --accent: var(--marino); }
  /* Rojo con la línea negra del escudo encima: azul, línea, franjas */
  .chapter--4 { --bg: var(--rojo); --accent: var(--crema); border-top: clamp(8px, 1vw, 12px) solid #0f1511; }

  .chapter__inner {
    width: min(100% - 2 * var(--gutter), 1200px);
    margin-inline: auto;
    display: grid;
    gap: clamp(2rem, 5vh, 3rem);
  }
  .chapter__text { display: grid; gap: 1.1rem; justify-items: start; }

  .story__title {
    font-size: var(--step-4);
    font-stretch: 118%;
    color: var(--claro);
  }

  .chapter__head { display: grid; gap: 0.6rem; justify-items: inherit; }
  .chapter__num {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 2px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }
  .chapter__title {
    font-size: var(--step-3);
    font-stretch: 96%;
  }
  .chapter__lead {
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 36ch;
  }
  .chapter__lead--big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.15;
    font-stretch: 90%;
    max-width: 24ch;
  }
  .chapter__punch {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--step-3);
    font-stretch: 115%;
    line-height: 1;
    color: var(--oro);
  }

  /* 02 · copia impresa */
  .chapter__media { display: grid; justify-items: center; }
  .print {
    width: min(80vw, 24rem);
    padding: 10px 10px 0;
    background: white;
    border-radius: var(--radius-paper);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 28px 50px -24px rgb(0 0 0 / 0.6);
    transform: rotate(-2.5deg);
  }
  .print__caption {
    padding: 0.7rem 0.25rem 0.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 92%;
    font-size: var(--step-0);
    line-height: 1.15;
    text-align: center;
    color: var(--marino);
  }
  .print :global(.print__img) {
    width: 100%;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: 1px;
  }

  /* 03 · puente a Valores */
  .chapter__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    font-weight: 650;
    color: inherit;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .chapter__link svg { width: 1.2em; height: 1.2em; }

  /* 04 · saque inicial: círculo central con el balón del escudo */
  .kickoff {
    position: relative;
    width: min(70vw, 20rem);
    aspect-ratio: 1;
    color: var(--crema);
    overflow: clip;
    border-radius: 50%;
    -webkit-mask: radial-gradient(closest-side, black 68%, transparent);
    mask: radial-gradient(closest-side, black 68%, transparent);
  }
  .kickoff :global(.kickoff__court) {
    position: absolute;
    width: 600%;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    opacity: 0.6;
    stroke-width: 0.5;
    --draw: 1;
  }
  .kickoff__ball {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    /* El balón del propio escudo (sin redibujar): recorte del SVG */
    background: url('/escudo.svg') no-repeat;
    background-size: 255.4% auto;
    background-position: 50% 66.7%;
    box-shadow: 0 10px 18px -8px rgb(0 0 0 / 0.5);
    animation: ball-bob 2.4s var(--ease-inout) infinite alternate;
  }
  @keyframes ball-bob { to { transform: translateY(-6%); } }

  /* ---------- ≥768 px: dos columnas y alineación alterna ---------- */
  @media (min-width: 768px) {
    .chapter--right .chapter__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      align-items: center;
      column-gap: 6vw;
    }
    /* Medio a la izquierda, texto a la derecha y alineado a la derecha */
    .chapter--right .chapter__media { grid-column: 1; grid-row: 1; }
    .chapter--right .chapter__text { grid-column: 2; justify-items: end; text-align: right; }
    .chapter--2 .print { width: min(30vw, 50svh, 26rem); }
    .chapter--4 .kickoff { width: min(32vw, 46svh, 22rem); }
    .chapter--1 .chapter__lead { font-size: var(--step-2); line-height: 1.3; max-width: 30ch; }
    .chapter--3 .chapter__lead--big { font-size: var(--step-3); max-width: 20ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kickoff__ball { animation: none; }
  }
</style>
