---
// Escudo del hero (escritorio): estático, sin recuadro, con sombra fija.
import escudo from '../generated/escudo.json';

const [, , vw, vh] = escudo.viewBox.split(' ').map(Number);
---

<img
  class="crest"
  src="/escudo.svg"
  width={Math.round(vw / 2)}
  height={Math.round(vh / 2)}
  alt="Escudo de S.D. Praga: banda azul con el nombre, franjas verticales rojas y blancas, un balón y una estrella roja."
  fetchpriority="high"
  decoding="sync"
  draggable="false"
/>

<style>
  .crest {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 28px 30px rgb(0 0 0 / 0.5)) drop-shadow(0 6px 6px rgb(0 0 0 / 0.35));
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
