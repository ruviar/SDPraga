---
// Barra de club fija arriba en todos los tamaños: escudo que sobresale por encima de las
// franjas del escudo que la rematan.
// Escritorio: enlaces en la barra. Móvil/tableta: botón de menú que abre un panel a
// pantalla completa bajo la barra (lógica en src/scripts/boot.ts, funciona sin esperar a GSAP).
import { content } from '../content';
---

<header class="nav" data-nav>
  <nav class="nav__bar" aria-label="Principal">
    <a class="nav__brand" href="#inicio">
      <span class="nav__crest"><img src="/escudo.svg" width="64" height="81" alt="" /></span>
      <span class="nav__name">{content.name}</span>
    </a>
    <ul class="nav__links">
      {content.nav.map((l) => (
        <li><a href={l.href} data-nav-link>{l.label}</a></li>
      ))}
    </ul>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-sheet" data-menu-toggle>
      <span class="nav__burger" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="visually-hidden" data-menu-label data-open={content.ui.close} data-closed={content.ui.menu}>{content.ui.menu}</span>
    </button>
    <span class="nav__bands" aria-hidden="true">{Array.from({ length: 7 }, () => <span />)}</span>
  </nav>

  <div class="sheet" id="nav-sheet" data-sheet hidden>
    <nav class="sheet__nav" aria-label="Secciones">
      <ul class="sheet__list">
        {content.nav.map((l, i) => (
          <li style={`--i:${i}`}>
            <a class="sheet__link" href={l.href} data-nav-link>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="sheet__motto">
      <img src="/escudo.svg" width="36" height="46" alt="" />
      <span>{content.motto}</span>
    </p>
    <span class="sheet__bands" aria-hidden="true">{Array.from({ length: 7 }, () => <span />)}</span>
  </div>
</header>

<style>
  .nav { position: relative; z-index: var(--z-nav); }

  /* ---------- Barra de club ---------- */
  .nav__bar {
    --bar-h: 60px;
    --crest-w: 50px;
    position: fixed;
    inset: 0 0 auto;
    height: var(--bar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 calc(var(--gutter) - 6px) 0 calc(var(--gutter) + var(--crest-w) + 14px);
    background: color-mix(in oklch, var(--marino), var(--azul-escudo) 12%);
    color: var(--claro);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.7);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  /* El escudo sobresale de la barra, con sombra fija */
  .nav__crest {
    position: absolute;
    left: var(--gutter);
    top: 6px;
    width: var(--crest-w);
    z-index: 2;
  }
  .nav__crest img { width: 100%; height: auto; filter: drop-shadow(0 8px 10px rgb(0 0 0 / 0.45)); }
  .nav__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 112%;
    font-size: 1rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .nav__links { display: none; list-style: none; padding: 0; gap: 0.25rem; height: 100%; }
  .nav__links li { display: flex; }
  .nav__links a {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 0.9rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 82%;
    font-size: 1rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    color: var(--claro-2);
    transition: color 180ms;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0;
    height: 4px;
    background: var(--rojo);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 200ms var(--ease-out);
  }
  .nav__links a:hover { color: var(--claro); }
  .nav__links a:hover::after { transform: scaleY(0.5); }
  .nav__links a[aria-current] { color: var(--claro); }
  .nav__links a[aria-current]::after { transform: none; }
  .nav__links a:focus-visible { outline-offset: -6px; box-shadow: none; }
  /* Franjas del escudo bajo la barra */
  .nav__bands, .sheet__bands {
    position: absolute;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }
  .nav__bands { top: 100%; height: 5px; z-index: 1; }
  .nav__bands span, .sheet__bands span { background: var(--rojo); }
  .nav__bands span:nth-child(even), .sheet__bands span:nth-child(even) { background: var(--crema); }

  /* ---------- Botón de menú (móvil / tableta) ---------- */
  .nav__toggle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--claro);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .nav__burger { position: relative; display: block; width: 24px; height: 16px; }
  .nav__burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 220ms var(--ease-out), opacity 150ms;
  }
  .nav__burger span:nth-child(1) { top: 0; }
  .nav__burger span:nth-child(2) { top: calc(50% - 1.25px); }
  .nav__burger span:nth-child(3) { bottom: 0; width: 66%; }
  .nav__toggle[aria-expanded='true'] .nav__burger span:nth-child(1) { transform: translateY(6.75px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] .nav__burger span:nth-child(2) { opacity: 0; }
  .nav__toggle[aria-expanded='true'] .nav__burger span:nth-child(3) { width: 100%; transform: translateY(-6.75px) rotate(-45deg); }

  /* ---------- Panel de secciones ---------- */
  .sheet {
    position: fixed;
    inset: calc(60px + 5px) 0 0;
    z-index: -1;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(1.5rem, 5svh, 2.5rem) var(--gutter) calc(2.5rem + env(safe-area-inset-bottom));
    overflow-y: auto;
    background:
      radial-gradient(80% 50% at 80% 0%, color-mix(in oklch, var(--azul-escudo), transparent 40%), transparent 70%),
      var(--marino);
    animation: sheet-in 260ms var(--ease-out);
  }
  .sheet[hidden] { display: none; }
  .sheet__list { list-style: none; padding: 0; }
  .sheet__list li { animation: sheet-item 320ms var(--ease-out) both; animation-delay: calc(var(--i) * 35ms + 60ms); }
  .sheet__link {
    display: flex;
    align-items: center;
    min-height: 64px;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in oklch, var(--crema), transparent 86%);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 90%;
    font-size: clamp(1.7rem, 7.5vw, 2.4rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--claro);
  }
  .sheet__link[aria-current] { color: var(--oro); }
  .sheet__link:focus-visible { outline-offset: 2px; box-shadow: none; }
  .sheet__motto {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    color: var(--claro-2);
  }
  .sheet__motto img { width: 36px; height: auto; flex: none; }
  .sheet__bands { bottom: 0; height: 8px; }
  @keyframes sheet-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes sheet-item { from { transform: translateY(12px); opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .sheet, .sheet__list li { animation: none; }
    .nav__burger span { transition: none; }
  }

  /* ---------- Escritorio ---------- */
  @media (min-width: 1024px) {
    .nav__bar { --bar-h: 68px; --crest-w: 72px; padding: 0 var(--gutter) 0 calc(var(--gutter) + 92px); gap: 2rem; }
    .nav__crest { top: 8px; }
    .nav__name { font-size: 1.15rem; }
    .nav__links { display: flex; }
    .nav__toggle, .sheet { display: none !important; }
  }
</style>
