---
// Escritorio: barra de club a todo el ancho (escudo que sobresale por encima de las
// franjas del escudo que la rematan).
// Móvil: dock inferior con escudo y botón Menú que abre un panel con botones físicos.
import { content } from '../content';
import Button from './Button.astro';
---

<header class="nav" data-nav>
  <nav class="nav__bar" aria-label="Principal">
    <a class="nav__brand" href="#inicio">
      <span class="nav__crest"><img src="/escudo.svg" width="64" height="81" alt="" /></span>
      <span class="nav__name">{content.name}</span>
    </a>
    <ul class="nav__links">
      {content.nav.map((l) => (
        <li><a href={l.href} data-nav-link>{l.label}</a></li>
      ))}
    </ul>
    <span class="nav__bands" aria-hidden="true">{Array.from({ length: 7 }, () => <span />)}</span>
  </nav>

  <div class="dock">
    <a class="dock__home" href="#inicio" aria-label={content.ui.home}>
      <img src="/escudo.svg" width="26" height="33" alt="" />
    </a>
    <Button variant="marino" class="dock__menu" aria-expanded="false" aria-controls="nav-sheet" data-menu-toggle>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
      <span data-menu-label data-open={content.ui.close} data-closed={content.ui.menu}>{content.ui.menu}</span>
    </Button>
  </div>

  <div class="sheet" id="nav-sheet" data-sheet hidden>
    <nav aria-label="Secciones">
      <ul class="sheet__list">
        {content.nav.map((l, i) => (
          <li style={`--i:${i}`}>
            <Button href={l.href} variant={i === content.nav.length - 1 ? 'rojo' : 'crema'} class="sheet__btn" data-sheet-link>{l.label}</Button>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>


<style>
  .nav { position: relative; z-index: var(--z-nav); }

  /* ---------- Barra de club (escritorio) ---------- */
  .nav__bar {
    position: fixed;
    inset: 0 0 auto;
    height: 68px;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 var(--gutter) 0 calc(var(--gutter) + 92px);
    background: color-mix(in oklch, var(--marino), var(--azul-escudo) 12%);
    color: var(--claro);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.7);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  /* El escudo sobresale de la barra, con sombra fija */
  .nav__crest {
    position: absolute;
    left: var(--gutter);
    top: 8px;
    width: 72px;
    z-index: 2;
  }
  .nav__crest img { width: 100%; height: auto; filter: drop-shadow(0 8px 10px rgb(0 0 0 / 0.45)); }
  .nav__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 112%;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .nav__links { display: flex; list-style: none; padding: 0; gap: 0.25rem; height: 100%; }
  .nav__links li { display: flex; }
  .nav__links a {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 0.9rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 82%;
    font-size: 1rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    color: var(--claro-2);
    transition: color 180ms;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0;
    height: 4px;
    background: var(--rojo);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 200ms var(--ease-out);
  }
  .nav__links a:hover { color: var(--claro); }
  .nav__links a:hover::after { transform: scaleY(0.5); }
  .nav__links a[aria-current] { color: var(--claro); }
  .nav__links a[aria-current]::after { transform: none; }
  .nav__links a:focus-visible { outline-offset: -6px; box-shadow: none; }
  /* Franjas del escudo bajo la barra */
  .nav__bands {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 5px;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    z-index: 1;
  }
  .nav__bands span { background: var(--rojo); }
  .nav__bands span:nth-child(even) { background: var(--crema); }

  /* ---------- Dock (móvil) ---------- */
  .dock {
    position: fixed;
    left: 50%;
    bottom: max(12px, env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 6px 6px 6px 6px;
    border-radius: 22px;
    background: var(--marino);
    box-shadow: 0 16px 34px -14px color-mix(in oklch, var(--marino), transparent 30%);
    z-index: calc(var(--z-nav) + 1);
  }
  .dock__home {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--crema);
  }
  .dock__home img { width: 26px; height: auto; }
  .dock :global(.dock__menu .btn__face) { padding: 0.8em 1.05em; background: color-mix(in oklch, var(--marino), var(--crema) 14%); }
  .dock :global(.dock__menu .btn__face svg) { width: 1.25em; height: 1.25em; }

  .sheet {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(max(12px, env(safe-area-inset-bottom)) + 76px);
    padding: 14px;
    border-radius: 22px;
    background: var(--marino);
    box-shadow: 0 24px 60px -20px color-mix(in oklch, var(--marino), transparent 20%);
    z-index: var(--z-nav);
    transform-origin: 50% 100%;
    animation: sheet-in 260ms var(--ease-out);
  }
  .sheet[hidden] { display: none; }
  .sheet__list { list-style: none; padding: 0; display: grid; gap: 14px; }
  .sheet__list li { animation: sheet-item 320ms var(--ease-out) both; animation-delay: calc(var(--i) * 30ms + 40ms); }
  .sheet :global(.sheet__btn) { width: 100%; }
  .sheet :global(.sheet__btn .btn__face) { justify-content: flex-start; font-family: var(--font-display); font-weight: 800; font-stretch: 112%; font-size: 1.2rem; }
  @keyframes sheet-in { from { transform: translateY(14px) scale(0.98); opacity: 0; } }
  @keyframes sheet-item { from { transform: translateY(10px); opacity: 0; } }

  @media (min-width: 1024px) {
    .nav__bar { display: flex; }
    .dock, .sheet { display: none !important; }
  }
</style>
