---
import { content } from '../content';
import Crest from './Crest.astro';
import Brush from './Brush.astro';
import Button from './Button.astro';
import Picture from './Picture.astro';
import images from '../generated/images.json';
import { siteConfig } from '../site.config';

// Móvil y tableta: variante elegida en site.config.ts (en escritorio no cambia).
const mobile = siteConfig.heroMobile;
// Equipo recortado (sin fondo blanco) para el «cartel». En escritorio el primer <source>
// entrega un GIF de 1 px: el navegador no descarga la ilustración que no va a mostrar.
const team = images['hero-equipo-recorte'];
const teamSet = (f: string) => team.widths.map((w) => `/img/hero-equipo-recorte-${w}.${f} ${w}w`).join(', ');
const blank = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<section class="hero mesh" id="inicio" aria-labelledby="hero-title" data-hero data-mobile={mobile}>
  <!-- Fondo, decorativo (alt vacío):
       · escritorio: la ilustración del equipo difuminada (`lazy`: en móvil no se descarga);
       · móvil 'franjas': las franjas del escudo oscurecidas. -->
  <div class="hero__bg" aria-hidden="true">
    {mobile === 'franjas' && <div class="hero__stripes">{Array.from({ length: 7 }, () => <span />)}</div>}
    <Picture name="hero-equipo" alt="" sizes="60vw" loading="lazy" fetchpriority="low" imgClass="hero__photo" />
  </div>

  {
    mobile === 'cartel' && (
      <picture class="hero__team">
        <source media="(min-width: 1024px)" srcset={blank} />
        <source type="image/avif" srcset={teamSet('avif')} sizes="100vw" />
        <source type="image/webp" srcset={teamSet('webp')} sizes="100vw" />
        <img
          class="hero__team-img"
          src="/img/hero-equipo-recorte-750.png"
          srcset={teamSet('png')}
          sizes="100vw"
          width={team.width}
          height={team.height}
          alt={content.hero.teamAlt}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    )
  }

  <div class="hero__crest">
    <Crest />
  </div>

  <div class="hero__copy">
    <h1 class="hero__title" id="hero-title">
      <span class="hero__sd">{content.nameShort}</span>
      <span class="hero__praga">{content.nameLong}</span>
    </h1>
    <p class="hero__motto"><Brush class="hero__brush">{content.motto}</Brush></p>
    <p class="hero__tagline">{content.tagline}</p>
    <div class="hero__ctas">
      <Button href={content.hero.ctaPrimary.href} variant="crema">
        {content.hero.ctaPrimary.label}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </Button>
      <Button href={content.hero.ctaSecondary.href} variant="rojo">{content.hero.ctaSecondary.label}</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    align-items: end;
    padding: calc(65px + 1rem) var(--gutter) calc(clamp(2rem, 6svh, 3.5rem) + env(safe-area-inset-bottom));
    overflow: clip;
    isolation: isolate;
    color: var(--claro);
    /* Azul de la camiseta: foco de luz tras el escudo que se apaga hacia el marino */
    background:
      radial-gradient(90% 60% at 64% 24%, var(--azul-camiseta) 0%, color-mix(in oklch, var(--azul-camiseta), var(--azul-escudo) 55%) 38%, transparent 78%),
      linear-gradient(to bottom, var(--azul-escudo) 0%, color-mix(in oklch, var(--azul-escudo), var(--marino) 55%) 70%, var(--marino) 100%);
  }


  /* ---------- Fondo bajo un velo marino ---------- */
  .hero__bg {
    position: absolute;
    inset: 65px 0 0;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
  }
  .hero__bg :global(picture) { display: none; position: absolute; inset: 0; }
  /* multiply: el blanco de la ilustración toma el azul del hero; blur + brillo la apagan */
  .hero__bg :global(.hero__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    mix-blend-mode: multiply;
    filter: blur(5px) brightness(0.78) saturate(1.05);
    /* El escalado (oculta el borde difuminado) se ancla arriba: no recorta las cabezas */
    transform: scale(1.06);
    transform-origin: 50% 0%;
    user-select: none;
  }
  /* Velo marino: oscurece hacia abajo, donde va el texto */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 0%, transparent 40%, rgb(8 18 43 / 0.6) 72%, var(--marino) 100%);
  }
  .hero__crest { display: none; }

  /* ---------- Móvil 'cartel': el equipo entero arriba, el nombre debajo ---------- */
  /* Equipo + nombre como un solo bloque, centrado en el alto disponible: sin hueco vacío
     entre ambos en móviles altos */
  .hero[data-mobile='cartel'] {
    grid-template-rows: auto auto;
    align-content: center;
    padding-top: 65px;
  }
  .hero__team {
    display: block;
    grid-area: 1 / 1;
    margin: clamp(0.75rem, 2.5svh, 1.5rem) calc(-1 * var(--gutter)) 0;
  }
  .hero__team-img {
    display: block;
    width: 100%;
    height: auto;
    /* Los pies se funden con el fondo: el nombre entra por debajo sin corte */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 72%, transparent 100%);
    user-select: none;
  }
  .hero[data-mobile='cartel'] .hero__copy {
    grid-area: 2 / 1;
    align-self: start;
    margin-top: calc(-1 * clamp(1rem, 6vw, 3.5rem));
  }

  /* ---------- Móvil 'franjas': franjas del escudo oscurecidas de fondo ---------- */
  .hero__stripes {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }
  .hero__stripes span { background: var(--rojo); }
  .hero__stripes span:nth-child(even) { background: var(--crema); }
  /* Arriba se reconocen el rojo y el blanco del escudo; hacia el texto se funden en marino */
  .hero[data-mobile='franjas'] .hero__bg::after {
    background: linear-gradient(
      to bottom,
      rgb(8 18 43 / 0.28) 0%,
      rgb(8 18 43 / 0.5) 30%,
      rgb(8 18 43 / 0.82) 58%,
      var(--marino) 82%
    );
  }

  .hero__copy {
    grid-area: 1 / 1;
    position: relative;
    z-index: 2;
  }
  .hero__title {
    display: grid;
    line-height: 0.8;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--claro);
    letter-spacing: -0.015em;
  }
  .hero__sd {
    font-size: clamp(2.6rem, 11vw, 5.5rem);
    font-stretch: 125%;
    color: var(--oro);
    padding-left: 0.04em;
  }
  .hero__praga {
    display: block;
    white-space: nowrap;
    font-size: clamp(4.6rem, 23vw, 12rem);
    font-stretch: calc(var(--wdth) * 1%);
    margin-left: -0.04em;
    contain: layout style;
    animation: praga-stretch 1000ms var(--ease-out) both;
    animation-delay: 220ms;
  }
  :global(.no-intro) .hero__praga { animation-delay: 80ms; }
  @keyframes praga-stretch {
    from { --wdth: 58; }
    to { --wdth: 100; }
  }

  .hero__motto {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 92%;
    font-size: var(--step-2);
    line-height: 1.1;
    max-width: 22ch;
  }
  .hero__motto :global(.brush__stroke) {
    clip-path: inset(0 100% 0 0);
    animation: brush-in 520ms var(--ease-out) forwards;
    animation-delay: 820ms;
  }
  :global(.no-intro) .hero__motto :global(.brush__stroke) { animation-delay: 700ms; }
  @keyframes brush-in { to { clip-path: inset(0 0 0 0); } }

  .hero__tagline {
    margin-top: 0.9rem;
    font-size: var(--step-1);
    color: var(--claro-2);
  }
  .hero__ctas {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 0.8rem;
  }


  /* Escritorio: nombre abajo-izquierda y escudo estático, sin recuadro, a la derecha */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: 1fr;
      align-items: end;
      padding: 7.5rem var(--gutter) clamp(2.5rem, 6vh, 4.5rem);
      column-gap: 4vw;
    }
    .hero__copy, .hero[data-mobile] .hero__copy { grid-area: 1 / 1; align-self: end; margin-top: 0; }
    .hero[data-mobile] { grid-template-rows: 1fr; align-content: normal; padding-top: 7.5rem; }
    .hero__bg { inset: 73px 0 0; }
    /* Escritorio: la ilustración del equipo difuminada de fondo, en todas las variantes */
    .hero__team, .hero__stripes { display: none; }
    .hero__bg :global(picture) { display: block; }
    .hero__bg :global(.hero__photo) { object-position: 50% 0%; filter: blur(7px) brightness(0.8) saturate(1.05); }
    /* Escritorio: el texto va abajo a la izquierda, el velo se oscurece hacia ahí
       (selector con [data-mobile] para ganar a los velos de las variantes móviles) */
    .hero[data-mobile] .hero__bg::after {
      background:
        linear-gradient(to right, rgb(8 18 43 / 0.62) 0%, rgb(8 18 43 / 0.3) 55%, rgb(8 18 43 / 0.2) 100%),
        linear-gradient(to bottom, rgb(8 18 43 / 0.15) 0%, rgb(8 18 43 / 0.25) 45%, rgb(8 18 43 / 0.75) 82%, var(--marino) 100%);
    }
    .hero__crest {
      display: block;
      grid-area: 1 / 2;
      align-self: center;
      justify-self: center;
      width: min(24vw, 52svh * 0.79);
      max-width: none;
      margin: 0 0 6svh;
      translate: -3vw 0;
    }
    .hero {
      background:
        radial-gradient(55% 75% at 74% 42%, var(--azul-camiseta) 0%, color-mix(in oklch, var(--azul-camiseta), var(--azul-escudo) 55%) 40%, transparent 80%),
        linear-gradient(to bottom, var(--azul-escudo) 0%, color-mix(in oklch, var(--azul-escudo), var(--marino) 50%) 75%, var(--marino) 100%);
    }
    .hero__motto { max-width: none; }
    .hero__praga { font-size: clamp(7rem, 14.2vw, 16rem); }
    .hero__sd { font-size: clamp(3.5rem, 6.2vw, 6.5rem); }
    .hero__motto { margin-top: 1.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__praga, .hero__motto :global(.brush__stroke) { animation: none; }
    .hero__motto :global(.brush__stroke) { clip-path: none; }
  }
</style>
