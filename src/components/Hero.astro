---
import { content } from '../content';
import Crest from './Crest.astro';
import Brush from './Brush.astro';
import Button from './Button.astro';
---

<section class="hero mesh" id="inicio" aria-labelledby="hero-title" data-hero>
  <!-- Móvil y tableta: el escudo como fondo, oscurecido, con el nombre encima -->
  <div class="hero__bg" aria-hidden="true">
    <img src="/escudo.svg" width="434" height="549" alt="" fetchpriority="high" decoding="sync" draggable="false" />
  </div>

  <div class="hero__crest">
    <Crest />
  </div>

  <div class="hero__copy">
    <h1 class="hero__title" id="hero-title">
      <span class="hero__sd">{content.nameShort}</span>
      <span class="hero__praga">{content.nameLong}</span>
    </h1>
    <p class="hero__motto"><Brush class="hero__brush">{content.motto}</Brush></p>
    <p class="hero__tagline">{content.tagline}</p>
    <div class="hero__ctas">
      <Button href={content.hero.ctaPrimary.href} variant="crema">
        {content.hero.ctaPrimary.label}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </Button>
      <Button href={content.hero.ctaSecondary.href} variant="rojo">{content.hero.ctaSecondary.label}</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    align-items: end;
    padding: calc(65px + 1rem) var(--gutter) calc(clamp(2rem, 6svh, 3.5rem) + env(safe-area-inset-bottom));
    overflow: clip;
    isolation: isolate;
    color: var(--claro);
    /* Azul de la camiseta: foco de luz tras el escudo que se apaga hacia el marino */
    background:
      radial-gradient(90% 60% at 64% 24%, var(--azul-camiseta) 0%, color-mix(in oklch, var(--azul-camiseta), var(--azul-escudo) 55%) 38%, transparent 78%),
      linear-gradient(to bottom, var(--azul-escudo) 0%, color-mix(in oklch, var(--azul-escudo), var(--marino) 55%) 70%, var(--marino) 100%);
  }


  /* ---------- Móvil / tableta: escudo de fondo con velo oscuro ---------- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    place-items: center;
    padding-top: 65px;
    overflow: clip;
    pointer-events: none;
  }
  /* Escudo grande, centrado detrás del nombre y apagado: marca de agua, no un segundo título */
  .hero__bg img {
    width: min(118vw, 84svh * 0.79, 44rem);
    height: auto;
    margin-top: -6svh;
    filter: brightness(0.62) saturate(0.85) drop-shadow(0 40px 60px rgb(0 0 0 / 0.5));
    user-select: none;
  }
  /* Velo: deja ver el escudo arriba y oscurece hacia el texto para que se lea encima */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 60% at 50% 38%, rgb(8 18 43 / 0.15) 0%, rgb(8 18 43 / 0.55) 75%),
      linear-gradient(
        to bottom,
        rgb(8 18 43 / 0.35) 0%,
        rgb(8 18 43 / 0.45) 40%,
        rgb(8 18 43 / 0.72) 62%,
        rgb(8 18 43 / 0.9) 82%,
        var(--marino) 100%
      );
  }
  .hero__crest { display: none; }

  .hero__copy {
    grid-area: 1 / 1;
    position: relative;
    z-index: 2;
  }
  .hero__title {
    display: grid;
    line-height: 0.8;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--claro);
    letter-spacing: -0.015em;
  }
  .hero__sd {
    font-size: clamp(2.6rem, 11vw, 5.5rem);
    font-stretch: 125%;
    color: var(--oro);
    padding-left: 0.04em;
  }
  .hero__praga {
    display: block;
    white-space: nowrap;
    font-size: clamp(4.6rem, 23vw, 12rem);
    font-stretch: calc(var(--wdth) * 1%);
    margin-left: -0.04em;
    contain: layout style;
    animation: praga-stretch 1000ms var(--ease-out) both;
    animation-delay: 220ms;
  }
  :global(.no-intro) .hero__praga { animation-delay: 80ms; }
  @keyframes praga-stretch {
    from { --wdth: 58; }
    to { --wdth: 100; }
  }

  .hero__motto {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 92%;
    font-size: var(--step-2);
    line-height: 1.1;
    max-width: 22ch;
  }
  .hero__motto :global(.brush__stroke) {
    clip-path: inset(0 100% 0 0);
    animation: brush-in 520ms var(--ease-out) forwards;
    animation-delay: 820ms;
  }
  :global(.no-intro) .hero__motto :global(.brush__stroke) { animation-delay: 700ms; }
  @keyframes brush-in { to { clip-path: inset(0 0 0 0); } }

  .hero__tagline {
    margin-top: 0.9rem;
    font-size: var(--step-1);
    color: var(--claro-2);
  }
  .hero__ctas {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 0.8rem;
  }


  /* Escritorio: nombre abajo-izquierda y escudo estático en su recuadro a la derecha */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: 1fr;
      align-items: end;
      padding: 7.5rem var(--gutter) clamp(2.5rem, 6vh, 4.5rem);
      column-gap: 4vw;
    }
    .hero__copy { grid-area: 1 / 1; align-self: end; }
    .hero__bg { display: none; }
    .hero__crest {
      display: block;
      grid-area: 1 / 2;
      align-self: end;
      justify-self: end;
      width: min(32vw, 66svh * 0.8);
      max-width: none;
      margin: 0;
    }
    .hero__crest :global(.crest) { aspect-ratio: 4 / 5; padding: 11% 14% 15%; }
    .hero {
      background:
        radial-gradient(55% 75% at 74% 42%, var(--azul-camiseta) 0%, color-mix(in oklch, var(--azul-camiseta), var(--azul-escudo) 55%) 40%, transparent 80%),
        linear-gradient(to bottom, var(--azul-escudo) 0%, color-mix(in oklch, var(--azul-escudo), var(--marino) 50%) 75%, var(--marino) 100%);
    }
    .hero__motto { max-width: none; }
    .hero__praga { font-size: clamp(7rem, 14.2vw, 16rem); }
    .hero__sd { font-size: clamp(3.5rem, 6.2vw, 6.5rem); }
    .hero__motto { margin-top: 1.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__praga, .hero__motto :global(.brush__stroke) { animation: none; }
    .hero__motto :global(.brush__stroke) { clip-path: none; }
  }
</style>
